# Copy to .env and edit before `docker compose up -d --build`.

# Pi-hole admin UI password (required).
PIHOLE_PASSWORD=change-me

# Timezone for Pi-hole logs/schedules.
TZ=UTC

# Pi-hole web UI port (served on the mesh IP and the container's bridge IP).
PIHOLE_WEB_PORT=80

# The NostrVPN source and commit are pinned in docker-compose.yml (NVPN_REPO,
# NVPN_COMMIT) and cannot be set here: a value in .env would build different
# code from what scripts/check-pins.sh checked. Change them in the compose file.

# NostrVPN's Linux tunnel interface name (default utun100). Only change this
# if you also change it in the nvpn config.
NVPN_TUN_IFACE=utun100

# nvpn dials two built-in public FIPS transit seeds (185.18.221.232 and
# 65.109.48.91), which joins this node to a public FIPS mesh. Set to "off" to
# never dial them. nvpn also keeps reading public Nostr discovery adverts
# either way; this switch only covers the seeds.
NVPN_FIPS_BOOTSTRAP=on

# Daemon log verbosity (a RUST_LOG filter, e.g. "info,fips_core=debug").
# Named SOVEREIGN_DNS_LOG, not RUST_LOG, so a RUST_LOG left in the shell that
# runs `docker compose` can never change it by accident.
# For debugging use the scoped form
# "info,nvpn=debug,fips_core=debug,nostr_vpn_core=debug,nostr_vpn_web=debug",
# never a bare "debug": that also turns on the relay client's logging, which
# writes every relay message (roster, member npubs, join requests) to the logs.
SOVEREIGN_DNS_LOG=info

# Port the self-hosted docs site is served on (http://localhost:<port>).
DOCS_PORT=8081

# Port the browser control panel (approve join requests, manage devices) is
# served on, loopback-only (http://localhost:<port>) — never exposed beyond
# this machine, since the panel has no login of its own.
WEB_UI_PORT=8082

# Dashboard (hub) on the home network, for a box with no screen. Leave unset
# for this computer only (http://localhost:8080, no password). Set with
# `bash scripts/hub-lan.sh on`, which writes both lines; the hub refuses to
# start with HUB_BIND=0.0.0.0 and no HUB_PASSWORD (8+ characters).
# HUB_BIND=0.0.0.0
# HUB_PASSWORD='pick-a-long-one'

# Dashboard from your other devices over NostrVPN (a phone on mobile data), at
# http://<this box's mesh IP>:8080. Mesh only: never the home network or the
# internet. Set with `bash scripts/hub-mesh.sh on`, which uses the same
# HUB_PASSWORD (or asks for one); the hub refuses to start with HUB_MESH=on and
# no HUB_PASSWORD. Pi-hole's page is at http://<mesh IP>/admin either way.
# HUB_MESH=on

# DNS for the whole home network: your router hands this box out as DNS, so
# every device in the house gets Pi-hole's blocking with no app. Off by
# default. Set with `bash scripts/dns-lan.sh on`, which writes both lines and
# prints the router steps. Port 53 on this one address, private senders only
# on Linux. Docker Desktop (macOS, Windows) cannot check senders, so the script
# refuses there unless SOVEREIGN_DNS_LAN_DESKTOP=1. Never forward port 53.
# COMPOSE_PROFILES=dns-lan
# DNS_LAN_BIND=192.168.1.20
